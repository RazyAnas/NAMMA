{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NAMMA Panorama Job Manifest",
  "type": "object",
  "required": ["schema_version", "panoramas"],
  "properties": {
    "schema_version": { "const": 1 },
    "scene_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "panoramas": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["pano_id", "image"],
        "properties": {
          "pano_id": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.(jpg|jpeg|png)$" },
          "sequence": { "type": "integer", "minimum": 0 },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "altitude_m": { "type": ["number", "null"] },
          "heading_deg": { "type": "number", "minimum": -360, "maximum": 360 },
          "pitch_deg": { "type": "number", "minimum": -90, "maximum": 90 },
          "roll_deg": { "type": "number", "minimum": -180, "maximum": 180 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
