+    const link = document.createElement('a');
+    link.href = `?scene=${encodeURIComponent(s.id)}`;
+    link.textContent = s.title;
+    if (s === scene) link.setAttribute('aria-current', 'true');
+    list.append(link);
+  }
+  document.title = `NAMMA · ${scene.title}`;
+  return `./data/${scene.dir}/`;
+}
