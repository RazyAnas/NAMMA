# Copy to .env for another machine. Paths are resolved from the project root.
APP_NAME=NAMMA
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data
LOG_DIR=./logs
DATABASE_URL=sqlite:///./data/namma.db
MAX_CONCURRENT_JOBS=1
MAX_UPLOAD_MB=2048
RECONSTRUCTION_BACKEND=modp
TRACKING_BACKEND=colmap
COLMAP_BIN=colmap
COLMAP_USE_GPU=true
COLMAP_EXHAUSTIVE_LOOP_CLOSURE=true
COLMAP_EXHAUSTIVE_MAX_IMAGES=500
QUALITY_MIN_REGISTERED_IMAGES=20
QUALITY_MIN_REGISTERED_RATIO=0.5
QUALITY_MIN_SPARSE_POINTS=1000
QUALITY_MAX_REPROJECTION_ERROR=2.0
# Recommended isolated trainer (run scripts/install_gaussian_env.ps1 first):
# .\.venv-gsplat\Scripts\python.exe scripts\train_splatfacto.py --dataset {dataset} --output {output}
GAUSSIAN_TRAINER_COMMAND=
# Dense collision candidate generation (native CUDA COLMAP + Open3D)
DENSE_MAX_IMAGE_SIZE=1280
DENSE_GPU_INDEX=-1
# Keep false on a Windows laptop display GPU; enable for a dedicated GPU/Linux quality run.
DENSE_GEOM_CONSISTENCY=false
DENSE_SOURCE_IMAGES=10
DENSE_WINDOW_STEP=2
DENSE_NUM_SAMPLES=10
DENSE_NUM_ITERATIONS=3
DENSE_MIN_NUM_PIXELS=5
DENSE_MAX_REPROJECTION_ERROR=2.0
COLLISION_MIN_DENSE_POINTS=5000
COLLISION_VOXELS_ACROSS_DIAGONAL=600
COLLISION_POISSON_DEPTH=9
COLLISION_DENSITY_TRIM_QUANTILE=0.02
COLLISION_TARGET_TRIANGLES=100000
COLLISION_GEOMETRY_BACKEND=monocular
# Apache-2.0 Depth Anything V2 Small predictor in the isolated CUDA environment:
# .\.venv-gsplat\Scripts\python.exe scripts\predict_depth_anything.py --images {images} --output {output}
MONOCULAR_DEPTH_COMMAND=
MONOCULAR_MIN_ALIGNMENT_POINTS=12
MONOCULAR_MAX_ALIGNMENT_ERROR=0.4
MONOCULAR_PIXEL_STRIDE=4
MONOCULAR_FUSION_VOXEL_SIZE=0.02
FFMPEG_BIN=ffmpeg
MODP_ROOT=./third_party/Online-3DGS-Monocular
MODP_PYTHON=
ORB_SLAM3_ROOT=./third_party/ORB_SLAM3
RECAST_BIN=
DEVICE=cuda:0
FRAME_SAMPLE_FPS=2
FRAME_MAX_WIDTH=1280
MAX_KEYFRAMES=500
AGENT_RADIUS_METERS=0.30
AGENT_HEIGHT_METERS=1.70
MAX_STEP_METERS=0.20
MAX_SLOPE_DEGREES=35
SAFETY_MARGIN_METERS=0.10
BLOCK_UNKNOWN_SPACE=true
REQUIRE_SCALE_CALIBRATION=true
ENABLE_RELOCALIZATION=false
